# ==============================================================================
# AETHERA PLATFORM CONFIGURATION (.env)
# Keep this file private and NEVER commit it to git repository.
# ==============================================================================

# 1. SERPAPI ENGINE INTEGRATIONS (Flights, Hotels, Maps Photos, Google Images)
# Engine 1: https://serpapi.com/search?engine=google_flights (Flight Search)
# Engine 2: https://serpapi.com/search?engine=google_hotels  (Live Hotel Search)
# Engine 3: https://serpapi.com/search?engine=google_maps_photos (Location Photos)
# Engine 4: https://serpapi.com/search?engine=google_images (Scenic Travel Photos)
# Get key from: https://serpapi.com/manage-api-key
SERPAPI_KEY=your_serpapi_key_here

# 2. GROQ AI ENGINE (Ultra-fast LLM travel planner & assistant - replaces Anthropic)
# Get key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 3. GOOGLE MAPS & PLACES (Live Radar, Hospitals & Interactive Waypoints)
# Required Google Cloud APIs: Maps JavaScript API, Places API, Directions API (or Routes API), Geocoding API
# Note: Restrict this key by HTTP referrer (e.g. http://localhost:5173/*, https://yourdomain.com/*) in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# 4. SERVER & NETWORK SETTINGS
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
API_RATE_LIMIT=120
AI_RATE_LIMIT=30


